<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.noo9.metrics-report</string>
  <key>ProgramArguments</key>
  <array><string>__REPO__/scripts/run_tick.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- Hourly on the hour. Unlike StartInterval, a missed slot during sleep fires once on wake. -->
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/noo9-metrics-report.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/noo9-metrics-report.log</string>
</dict>
</plist>
